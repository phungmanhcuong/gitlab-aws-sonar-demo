# Copy to infra/bootstrap/bootstrap.env (git-ignored) and fill in. Used once by an AWS admin.
AWS_REGION=ap-southeast-1
NAME=gitlab-aws-sonar-demo              # GitLab project name: state bucket <NAME>-tfstate-<account>, roles <NAME>-ci-*
PREFIX=shortlinks                       # Terraform var.name: prefix of every resource the pipeline creates
PROJECT_PATH=your-group/gitlab-aws-sonar-demo
PROJECT_ID=12345678                     # GitLab project id (Settings > General)
